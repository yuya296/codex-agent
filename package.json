{
  "name": "codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "doctor": "node --no-warnings --import tsx src/cli/doctor.ts",
    "start": "node --no-warnings --import tsx src/main.ts",
    "dev": "node --no-warnings --watch --import tsx src/main.ts",
    "test": "tsx --test tests/specs/*/*.test.ts tests/integration/*.test.ts"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.20.2",
    "@chat-adapter/state-redis": "^4.20.2",
    "@hono/node-server": "^1.19.11",
    "chat": "^4.20.2",
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
