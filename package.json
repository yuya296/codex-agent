{
  "name": "codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "doctor": "node --no-warnings --import tsx src/cli/doctor.ts",
    "start": "node --no-warnings --import tsx src/main.ts",
    "dev": "node --no-warnings --watch --import tsx src/main.ts",
    "test": "tsx --test tests/specs/*/*.test.ts tests/integration/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
