{
  "name": "codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "setup": "node --no-warnings --import tsx src/cli/setup.ts",
    "doctor": "node --no-warnings --import tsx src/cli/doctor.ts",
    "start": "node --no-warnings --import tsx src/main.ts",
    "dev": "node --no-warnings --watch --import tsx src/main.ts",
    "test": "node --no-warnings --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@slack/bolt": "^4.5.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
